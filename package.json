{
  "name": "rift-companion",
  "version": "1.4.0",
  "private": true,
  "description": "Companion app para League of Legends: builds, runas, partida ao vivo e histórico.",
  "engines": {
    "node": ">=24.21"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "build:electron": "node scripts/clean.js dist-electron && tsc -p electron/tsconfig.json",
    "build:renderer": "npm --prefix renderer run build -- --base-href ./",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "dev": "npm run build:electron && concurrently -k -n ng,electron \"npm --prefix renderer start\" \"wait-on http://localhost:4200 && cross-env RENDERER_URL=http://localhost:4200 electron .\"",
    "icon": "electron scripts/render-icon.js",
    "dist": "npm run build && electron-builder --win portable --x64",
    "test": "npm run build:electron && node --test \"test/**/*.test.js\"",
    "release": "npm run dist && node scripts/publish-release.js"
  },
  "dependencies": {
    "@blamejs/pki": "^0.9.5",
    "qrcode": "^1.5.4",
    "saxes": "^6.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "wait-on": "^8.0.5"
  },
  "productName": "Rift Companion",
  "author": "Rift Companion",
  "build": {
    "appId": "br.com.workscanner.riftcompanion",
    "productName": "Rift Companion",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "renderer/dist/renderer/browser/**/*",
      "builds/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "RiftCompanion-${version}.exe"
    }
  }
}
