{
  "name": "rift-companion",
  "version": "1.26.7",
  "private": true,
  "description": "Companion app para League of Legends: builds, runas, partida ao vivo e histórico.",
  "engines": {
    "node": ">=24.21"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "build:electron": "node scripts/clean.js dist-electron && tsc -p electron/tsconfig.json",
    "build:renderer": "npm --prefix renderer run build -- --base-href ./",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "dev": "npm run build:electron && concurrently -k -n ng,electron \"npm --prefix renderer start\" \"wait-on http://localhost:4200 && cross-env RENDERER_URL=http://localhost:4200 electron .\"",
    "icon": "electron scripts/render-icon.js",
    "dist": "npm run build && electron-builder --win portable --x64",
    "test": "npm run build:electron && node --test \"test/**/*.test.js\"",
    "release": "npm run dist && node scripts/publish-release.js",
    "release:android": "npm --prefix renderer run android:apk && node scripts/publish-android.js",
    "review": "node scripts/visual-review.cjs",
    "dist:store": "npm run build && node scripts/dist-store.js"
  },
  "dependencies": {
    "@blamejs/pki": "^0.9.5",
    "better-sqlite3": "^13.0.3",
    "qrcode": "^1.5.4",
    "saxes": "^6.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "wait-on": "^8.0.5"
  },
  "productName": "Rift Companion",
  "author": "Rift Companion",
  "build": {
    "appId": "br.com.workscanner.riftcompanion",
    "productName": "Rift Companion",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "renderer/dist/renderer/browser/**/*",
      "builds/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "RiftCompanion-${version}.exe"
    },
    "appx": {
      "identityName": "MatheusMunhoz.RiftCompanion",
      "publisher": "CN=7E66A870-83C4-4ECB-9F96-9178C2D1CF44",
      "publisherDisplayName": "Matheus Munhoz",
      "applicationId": "RiftCompanion",
      "displayName": "Rift Companion",
      "backgroundColor": "transparent",
      "languages": [
        "pt-BR"
      ],
      "customExtensionsPath": "build/appx-extensions.xml",
      "artifactName": "RiftCompanion-${version}.${ext}",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0"
    }
  }
}
